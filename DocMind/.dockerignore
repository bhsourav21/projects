# Version control
.git
.gitignore

# Secrets — must never be baked into an image layer
.env

# Local virtual environment (built fresh inside the image by `uv sync`)
.venv

# Byte-compiled / cache
__pycache__/
*.py[codz]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Docker
Dockerfile
.dockerignore

# Editor / OS cruft
.vscode/
.idea/
.DS_Store

# Local eval output (regenerated by running eval/ragas_eval.py, not needed at runtime)
eval/ragas_results.csv

# Planning docs (not needed at runtime, keep image lean)
**/PLAN.md